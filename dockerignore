# KORU ONE — root Docker build context exclusions.
# Never send local secrets or development data into Docker build contexts.
.git
.github
.gitignore
.vscode
.idea
.vs

# Secrets / credentials (do not exclude .env.example documentation).
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/secrets/
*.pem
*.key
*.pfx
*.p12

# .NET and JS build outputs.
**/bin/
**/obj/
**/TestResults/
**/coverage/
**/node_modules/
**/.next/
**/.turbo/
**/dist/
**/out/

# Local infrastructure state and logs.
**/.DS_Store
**/Thumbs.db
**/*.log
**/*.rdb
**/appendonly.aof*
**/*.sqlite
**/*.db
**/tmp/
**/temp/
**/benchmark-results/
**/*.BenchmarkDotNet.Artifacts/

# Prevent local volume mounts and runtime state entering build context.
**/data/
**/certs/local/
