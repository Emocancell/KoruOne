# KORU ONE — SADECE YEREL GELISTIRME ICIN ORNEK AYARLAR
# Kopyala: cp .env.example .env
# Bu ornek sifreleri kullanmadan once .env'de degistirin.
# .env, Git'e eklenmemelidir. Production: secret manager / Vault.

# PostgreSQL 17
POSTGRES_DB=koruone
POSTGRES_USER=koruone
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis 8 — cache (kalici olmayan, read-optimized)
REDIS_CACHE_PASSWORD=change-me-local-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_MAXMEMORY=256mb

# Redis 8 — Streams (AOF ile kalicilik)
REDIS_STREAMS_PASSWORD=change-me-local-streams
REDIS_STREAMS_PORT=6380

# Gelistirme araclari — docker-compose.dev.yml
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak
KEYCLOAK_PORT=8081
REDISINSIGHT_PORT=5540
PGADMIN_EMAIL=developer@example.test
PGADMIN_PASSWORD=change-me-local-pgadmin
PGADMIN_PORT=5050

# Monitoring — docker-compose.observability.yml
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana

# NOT: API/OIDC adresleri ve servis hesaplari ileride eklenecek.
# NOT: Bu compose kurulumu TLS, AD ve production network policy SAGLAMAZ.
