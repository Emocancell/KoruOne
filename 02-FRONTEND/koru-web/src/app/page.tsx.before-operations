"use client";

import HrWorkspace from "./HrWorkspace";
import {useEffect,useState} from 'react';
import {UserManager} from 'oidc-client-ts';
const authority=process.env.NEXT_PUBLIC_OIDC_AUTHORITY||'http://localhost:8081/realms/koru';
const manager=typeof window!=='undefined'?new UserManager({authority,client_id:'koru-web',redirect_uri:window.location.origin+'/callback',response_type:'code',scope:'openid profile email'}):null;
const api=process.env.NEXT_PUBLIC_API_URL??'';
export default function Home(){const [hrSupportOpen,setHrSupportOpen]=useState(false);const [token,setToken]=useState('');const [me,setMe]=useState<any>(null);const [dashboard,setDashboard]=useState<any>(null);const [tickets,setTickets]=useState<any[]>([]);const [products,setProducts]=useState<any[]>([]);const [ads,setAds]=useState<any[]>([]);const [title,setTitle]=useState('');const [error,setError]=useState('');
const [health,setHealth]=useState('');
async function request(path:string,opts:RequestInit={}){const res=await fetch(api+path,{...opts,headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json',...opts.headers}});if(!res.ok){
 const message=await res.text();
 throw Error('HTTP '+res.status+' - '+message.slice(0,350));
}
return res.json()}
async function refresh(){try{const [u,d,t,p,a]=await Promise.all([request('/api/me'),request('/api/dashboard'),request('/api/tickets'),request('/api/products'),request('/api/advertisements')]);setMe(u);setDashboard(d);setTickets(t);setProducts(p);setAds(a);setError('')}catch(e:any){setError(e.message)}}
useEffect(()=>{manager?.getUser().then(u=>{if(u?.access_token)setToken(u.access_token)})},[]);
useEffect(()=>{if(token)refresh()},[token]);

async function checkHealth(){
 try{
  const res=await fetch('/health',{cache:'no-store'});
  if(!res.ok)throw Error('HTTP '+res.status);
  const data=await res.json();
  setHealth('API AKTIF - '+(data.status||'OK'));
  setError('');
 }catch(e:any){
  setHealth('API BAGLANTI HATASI');
  setError(e.message);
 }
}

async function closeTicket(id:number){
 try{
  await request('/api/tickets/'+id+'/status',{
   method:'PATCH',
   body:JSON.stringify({status:'closed'})
  });
  await refresh();
 }catch(e:any){
  setError('Ticket kapatilamadi: '+e.message);
 }
}

const canCloseTicket=me?.roles?.some(
 (r:string)=>['admin','it','network'].includes(r)
)??false;

async function createTicket(){
if(!title.trim()){
 setError('Ticket basligi giriniz.');
 return;
}
try{await request('/api/tickets',{method:'POST',body:JSON.stringify({title,department:'General'})});setTitle('');await refresh()}catch(e:any){setError(e.message)}}
return <><header><div className="brand">KORU <span>ONE</span></div><div>{me?.name||'Kurumsal Portal'} <button className="secondary" onClick={()=>token?manager?.signoutRedirect():manager?.signinRedirect()}>{token?'Çıkış':'Kurumsal Giriş'}</button></div></header><main><p className="muted">ENTERPRISE OPERATIONS · REDIS INTELLIGENCE</p><h1>Kurumsal Yönetim Merkezi</h1><p className="muted">Departman operasyonları, Redis performansı ve güvenli yetkilendirme tek merkezde.</p>{!token?<div className="card">Dashboard ve departman işlemlerine erişmek için kurumsal hesabınızla giriş yapın.</div>:<><div className="row"><button onClick={refresh}>Yenile</button><button className="secondary" onClick={checkHealth}>
API Sağlık
</button>
{health&&<span role="status">{health}</span>}</div>{error&&<p className="error">{error}</p>}<p className="muted">Roller: {me?.roles?.join(', ')||'—'}</p><div className="cards">{[['Personel',dashboard?.data?.employees],['Toplam Ticket',dashboard?.data?.tickets],['Açık Ticket',dashboard?.data?.openTickets],['Ürün',dashboard?.data?.products],['Reklam',dashboard?.data?.advertisements]].map(([k,v])=><div className="card" key={String(k)}>{k}<strong>{v??'—'}</strong></div>)}</div><div className="card"><h2>Redis Cache Gözlemi</h2><p>Veri kaynağı: <b>{dashboard?.source||'—'}</b></p><p>İstek süresi: <b>{dashboard?.elapsedMs?.toFixed(2)??'—'} ms</b></p><p className="muted">İlk sorgu PostgreSQL; sonraki sorgular Redis HIT olarak ölçülür. Bu değerler gerçek API ölçümleridir.</p></div>{me?.roles?.some((r:string)=>['hr','admin'].includes(r)) && <HrWorkspace token={token} />}{me?.roles?.includes('hr') && <div className='row'><button className='secondary' onClick={()=>setHrSupportOpen(!hrSupportOpen)}>{hrSupportOpen?'Destek Masasını Gizle':'Destek Masasını Aç'}</button></div>}{(!me?.roles?.includes('hr') || hrSupportOpen) && <section className="card"><h2>IT / Network Ticket Yönetimi</h2><div className="row"><input placeholder="Ticket başlığı" value={title} onChange={e=>setTitle(e.target.value)}/><button disabled={!title.trim()} onClick={createTicket}>Ticket Aç</button><button className="secondary" onClick={async()=>{const r=await fetch(api+'/api/reports/tickets.csv',{headers:{Authorization:'Bearer '+token}});if(!r.ok){setError('Rapor yetkisi yok');return}const blob=await r.blob();const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='tickets.csv';a.click();URL.revokeObjectURL(url)}}>Excel Uyumlu CSV</button></div><table><thead><tr><th>ID</th><th>Başlık</th><th>Departman</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>{tickets.map(t=><tr key={t.id}><td>{t.id}</td><td>{t.title}</td><td>{t.department}</td><td>{t.status}</td>
<td>
 {canCloseTicket&&t.status!=='closed'&&
 <button onClick={()=>closeTicket(t.id)}>
 Ticket Kapat
 </button>}
</td></tr>)}</tbody></table></section>}<section className="card"><h2>Ürün Kataloğu</h2><table><tbody>{products.map(p=><tr key={p.id}><td>{p.name}</td><td>{p.price} ₺</td></tr>)}</tbody></table></section><section className="card"><h2>Yayındaki Reklamlar</h2>{ads.map(a=><p key={a.id}><b>{a.title}</b> — {a.content}</p>)}</section></>}</main></>}
