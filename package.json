{
  "name": "koru-one",
  "version": "0.1.0",
  "private": true,
  "description": "KORU ONE — Enterprise Operations & Redis Control Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "infra:logs": "docker compose logs -f",
    "infra:validate": "docker compose config --quiet",
    "infra:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "infra:metrics": "docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d",
    "dev": "pnpm --filter @koru-one/web dev",
    "build": "pnpm --filter @koru-one/web build",
    "lint": "pnpm --filter @koru-one/web lint",
    "typecheck": "pnpm --filter @koru-one/web typecheck"
  }
}
